<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:text="AutoConfirm SMS Forwarder"
            android:textSize="20sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/>

        <TextView android:text="URL Webhook" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/etUrl"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="https://autoconfirm.online/webhook/saas"
            android:inputType="textUri" android:layout_marginBottom="12dp"/>

        <TextView android:text="Token" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/etToken"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="linebet2026secret" android:layout_marginBottom="12dp"/>

        <TextView android:text="Expediteur 1 (Wave)" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/etSender1"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Wave" android:layout_marginBottom="8dp"/>

        <TextView android:text="Expediteur 2 (Orange)" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/etSender2"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Orange" android:layout_marginBottom="8dp"/>

        <TextView android:text="Expediteur 3 (MTN)" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/etSender3"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="MobileMoney" android:layout_marginBottom="16dp"/>

        <Button android:id="@+id/btnSave"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Sauvegarder et Demarrer"
            android:backgroundTint="#1a237e" android:textColor="#ffffff"
            android:layout_marginBottom="8dp"/>

        <Button android:id="@+id/btnStart"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Demarrer le Service"
            android:backgroundTint="#10b981" android:textColor="#ffffff"/>
    </LinearLayout>
</ScrollView>
